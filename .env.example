# Copy to .env and replace only the placeholders needed for your chosen provider.
# Both evaluator/evaluator.py and benchmark_runner.py load the repo-root .env.
# Exported shell variables take precedence. Values below are dummy placeholders.

# Evaluator judge: rits (default) or groq.
JUDGE_BACKEND=rits
RITS_API_KEY=dummy-rits-api-key
# The Groq judge reads API_KEY (not GROQ_API_KEY).
API_KEY=dummy-groq-api-key

# Benchmark LLM providers: selected using --provider / --model CLI options.
# RITS also uses RITS_API_KEY above.
OPENAI_API_KEY=dummy-openai-api-key
ANTHROPIC_API_KEY=dummy-anthropic-api-key
LITELLM_API_KEY=dummy-litellm-api-key
# Optional LiteLLM proxy (uncomment when needed):
# LITELLM_BASE_URL=https://your-litellm-proxy.example/v1

WATSONX_APIKEY=dummy-watsonx-api-key
WATSONX_PROJECT_ID=dummy-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Use SPACE_ID instead of PROJECT_ID if required; do not set both.
# WATSONX_SPACE_ID=dummy-watsonx-space-id

# Optional local Ollama provider; no credential is required.
# OLLAMA_BASE_URL=http://localhost:11434

# Hosted capability app URLs (not the browser explorer URL).
# Evaluator: --tool-backend code-engine
# Runner: --mcp-config benchmark/mcp_connection_config.ce.yaml
# Only the selected capability's URL needs to be configured.
VAKRA_CAP1_URL=https://vakra-cap1.example.invalid
VAKRA_CAP2_URL=https://vakra-cap2.example.invalid
VAKRA_CAP3_URL=https://vakra-cap3.example.invalid
VAKRA_CAP4_URL=https://vakra-cap4.example.invalid

# Benchmark timeouts/retries; these numeric defaults are usable as-is.
AGENT_TIMEOUT_SECONDS=300
RITS_REQUEST_TIMEOUT_SECONDS=60
RITS_MAX_RETRIES=2

# Optional benchmark input-directory overrides. CLI arguments still select domains.
# CAPABILITY_1_DIR=/path/to/capability_1_bi_apis
# CAPABILITY_2_DIR=/path/to/capability_2_dashboard_apis
# CAPABILITY_3_DIR=/path/to/capability_3_multihop_reasoning
# CAPABILITY_4_DIR=/path/to/capability_4_multiturn

# Optional dataset download credentials (leave unset for public/anonymous access).
# HF_TOKEN=dummy-hugging-face-token
